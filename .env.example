# ============================================
# 工贸一体 MES 系统 — 环境变量配置模板
# ============================================
# 复制此文件为 .env，填入你的实际配置
# .env 文件不会被提交到 Git

# 数据库 (MySQL)
MES_DB_USERNAME=root
MES_DB_PASSWORD=your_db_password_here

# RabbitMQ
MES_RABBITMQ_USERNAME=mes1
MES_RABBITMQ_PASSWORD=your_rabbitmq_password_here
MES_RABBITMQ_ENABLED=true

# 邮件 (SMTP)
MES_MAIL_USERNAME=your_email@163.com
MES_MAIL_PASSWORD=your_smtp_password_here

# AI (DeepSeek)
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# CORS 允许的来源（生产环境改为你的实际域名）
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Knife4j API 文档（生产环境设为 false）
KNIFE4J_ENABLE=false
